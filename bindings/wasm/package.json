{
  "name": "airlox-core",
  "version": "0.1.0",
  "description": "Airlox protocol core compiled to WebAssembly",
  "homepage": "https://github.com/claudezss/airlox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudezss/airlox.git",
    "directory": "bindings/wasm"
  },
  "keywords": ["airlox", "wasm", "e2e", "encryption", "agents"],
  "exports": {
    ".": {
      "node": {
        "types": "./pkg/node/airlox_core_wasm.d.ts",
        "default": "./pkg/node/airlox_core_wasm.js"
      },
      "default": {
        "types": "./pkg/web/airlox_core_wasm.d.ts",
        "default": "./pkg/web/airlox_core_wasm.js"
      }
    },
    "./node": {
      "types": "./pkg/node/airlox_core_wasm.d.ts",
      "default": "./pkg/node/airlox_core_wasm.js"
    },
    "./web": {
      "types": "./pkg/web/airlox_core_wasm.d.ts",
      "default": "./pkg/web/airlox_core_wasm.js"
    }
  },
  "types": "./pkg/node/airlox_core_wasm.d.ts",
  "main": "./pkg/node/airlox_core_wasm.js",
  "files": ["pkg/node", "pkg/web", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "cargo build -p airlox-core-wasm --release --target wasm32-unknown-unknown && wasm-bindgen ../../target/wasm32-unknown-unknown/release/airlox_core_wasm.wasm --out-dir pkg/web --target web && wasm-bindgen ../../target/wasm32-unknown-unknown/release/airlox_core_wasm.wasm --out-dir pkg/node --target nodejs",
    "test": "node --test tests/*.test.mjs"
  }
}
